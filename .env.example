# Optional; the Tailnet page can log in through a browser instead. Tag the
# key and give the tag autoApprovers in the ACL to skip route approval.
TS_AUTHKEY=

# Node name in the tailnet.
TS_HOSTNAME=tsv-vpn

# 32-byte key encrypting the stored VPN credentials, mounted as a Docker secret:
#   openssl rand -hex 32 > master.key
# Back it up; without it the stored PSKs and passwords are unrecoverable.
MASTER_KEY_PATH=./master.key

# Optional. Left empty, the UI asks for an admin password on first visit and
# stores it. Set it to pin the password from the environment instead:
#   docker run --rm ghcr.io/testseve/tsv-vpn hash-password 'your password'
# Quote it; bcrypt hashes contain $.
ADMIN_PASSWORD_HASH=

# Structured logs print to the container's stderr (docker logs) and to a daily
# file under /data/logs, kept 30 days. /data is already a volume, so they
# persist across restarts. Override the location or retention if you like:
#   TSV_VPN_LOG_DIR=/data/logs
#   TSV_VPN_LOG_RETENTION=720h
